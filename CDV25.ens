LEA: MACRO (reg, ETIQ)
 or reg, r0, low(ETIQ)
 or.u reg, reg, high(ETIQ)
 ENDMACRO
 
LOAD: MACRO (reg, ETIQ)
 LEA (reg, ETIQ)
 ld reg, reg, r0
 ENDMACRO

PUSH: MACRO (ra)
 subu r30, r30, 4
 st ra, r30, r0
 ENDMACRO

POP: MACRO(ra)
 ld ra, r30, 0
 addu r30, r30, 4
 ENDMACRO
 
DBNZ: MACRO (reg, ETIQ)
 sub reg, reg, 1      
 cmp r7,reg,0
 bb1 eq,r7,ETIQ 
 ENDMACRO

org 0x00
br ppalV


org 0x2000
cadena: data "Esto es una prueba de LongCad\0"
cadena2: data "Esto es una prueba de CoincidenCad\0"
C: data "_" 
REF: data  "AAAABBBBCCCCDDDDEEEE_Fin.__.\0"
from: data 4
to: data 25
org 0x3000
;PRUEBA LongCad
ppalLC: 
	or r30, r0, 0x9000
	or r31, r30, r30 ;puntero r31
	LEA (r20, cadena) ; se inicializa la cadena en r20
	PUSH (r20) ; se mete la cadena en la pila apuntada por r30
	bsr LongCad
	
	addu r30,r30,4; se devuelve r30 a su estado anterior con el puntero
	stop
	
org 0x3100
;PRUEBA BuscaCar
ppalBC:
	or r30, r0, 0x9000
	or r31, r30, r30
	LOAD (r4, C) ; or r11, r0, 0x5F ; igual a "_"
	LEA (r20, REF)
	LOAD (r3, from) ; or r12, r0, 4
	LOAD (r2, to) ; or r13, r0, 25
	PUSH (r2) ; to
	PUSH (r3) ; from
	PUSH (r20) ; REF
	PUSH (r4) ; C
	bsr BuscaCar

	addu r30, r30, 16
	stop

org 0x3500
;PRUEBA CoincidenCad
ppalCC: 
	or r30, r0, 0x9000
	or r31, r30, r30 ;puntero r31
	LEA (r20, cadena) ; se inicializa la cadena en r20
	LEA (r21, cadena2); se inicializa la cadena2 en r21
	PUSH (r20) ; se mete la cadena en la pila apuntada por r30,4
	PUSH (r21) ; se mete la cadena2 en la pila apuntada por r30
	bsr CoincidenCad

	addu r30,r30,8; se devuelve r30 a su estado anterior con el puntero
	stop

